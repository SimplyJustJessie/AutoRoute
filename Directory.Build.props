<Project>

  <PropertyGroup>
    <!--
      Maintain a NuGet lock file (packages.lock.json) next to every project.

      Restore resolves the whole transitive graph — ~59 packages for the app — and only the direct
      references are pinned in the .csproj. The lock file records the exact resolved version AND a
      SHA-512 content hash for every package, so the graph is reproducible and any substituted
      artifact is detectable.

      This property only WRITES/refreshes the lock; it does not enforce it, so adding or bumping a
      package locally still works and simply updates the file (commit it with the change).
      Enforcement is opt-in, via restore's locked mode, which fails (NU1004) when the lock and the
      projects disagree:
        · CI runs it on every build, so a bump that forgets to refresh the lock cannot land.
        · The AUR PKGBUILD runs it, so a from-source package build fetches exactly the audited
          set or fails. The point being that `dotnet` in build() pulls code pacman cannot vet.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!--
      Declare the RID the lock has to cover. A lock generated by a plain restore records no
      runtime identifiers, so a RID-specific restore resolves extra RID assets and locked mode
      rejects it (NU1004, "the project's runtime identifiers have changed") — which is exactly
      what both shipping builds do: the AppImage publishes self-contained linux-x64, and the AUR
      package publishes framework-dependent linux-x64. Declaring it here means an ordinary
      `dotnet restore` locks the same graph those builds ask for.

      AutoRoute drives PipeWire and is Linux-only by nature (the app project already declares
      SupportedOSPlatform("linux")), so there is no other RID to carry.
    -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
