<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="using:AutoRoute.App.Behaviors">

    <!-- ============================ Chrome / panels ============================ -->

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    </Style>

    <!-- Body text color: set per-class (a global TextBlock style would stomp on
         button/presenter foregrounds via style priority). -->
    <Style Selector="TextBlock.body">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- Small-caps section label ("SOURCES", toolbar groups). -->

    <Style Selector="TextBlock.hint">
        <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <!-- Tinted pills: translucent state color behind state-colored text. -->

    <Style Selector="Border.chip">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chip > TextBlock">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.8" />
    </Style>
    <Style Selector="Border.chip.unsaved">
        <Setter Property="Background" Value="{DynamicResource UnsavedDimBrush}" />
    </Style>
    <Style Selector="Border.chip.unsaved > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource UnsavedBrush}" />
    </Style>
    <Style Selector="Border.chip.manual">
        <Setter Property="Background" Value="{DynamicResource ManualDimBrush}" />
    </Style>
    <Style Selector="Border.chip.manual > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ManualBrush}" />
    </Style>
    <Style Selector="Border.chip.protected">
        <Setter Property="Background" Value="{DynamicResource ProtectedDimBrush}" />
    </Style>
    <Style Selector="Border.chip.protected > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ProtectedBrush}" />
    </Style>

    <!-- Floating drag ghost that follows the pointer (built in code by DragGhost). -->
    <Style Selector="Border.dragGhost">
        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="BoxShadow" Value="0 6 20 0 #66000000" />
        <!-- Resting state is fully styled (no fade) so the ghost never renders half-baked;
             the entrance is just a quick scale pop. -->
        <Setter Property="Opacity" Value="0.95" />
        <Style.Animations>
            <Animation Duration="0:0:0.16" Easing="CubicEaseOut" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="ScaleTransform.ScaleX" Value="0.85" />
                    <Setter Property="ScaleTransform.ScaleY" Value="0.85" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="ScaleTransform.ScaleX" Value="1" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border.dragGhost Path">
        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.dragGhost TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- Ghost icon button (lock, remove ×). -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon Path">
        <Setter Property="Fill" Value="{DynamicResource FaintBrush}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Fill" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ManualDimBrush}" />
    </Style>
    <Style Selector="Button.icon:pointerover Path">
        <Setter Property="Fill" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.icon.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerDimBrush}" />
    </Style>
    <Style Selector="Button.icon.danger:pointerover Path">
        <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- Small text action ("Save" / "Keep") on unsaved cards. -->
    <Style Selector="Button.chipAction">
        <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chipAction:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="#101014" />
    </Style>

    <!-- Thin divider between the app actions and the window caption buttons. -->
    <Style Selector="Border.captionSep">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="6,0,2,0" />
        <Setter Property="Background" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Window caption buttons sit flush at the top-right edge of the title bar. -->
    <Style Selector="Button.icon.caption">
        <Setter Property="Padding" Value="7" />
        <Setter Property="CornerRadius" Value="7" />
    </Style>

    <!-- Audio/Video switcher, inline in the board's own toolbar (BoardView.axaml) next to the brand. -->
    <Style Selector="Border.tabPillGroup">
        <Setter Property="Background" Value="{DynamicResource ColumnHeaderBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tabPill">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tabPill:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ManualDimBrush}" />
    </Style>
    <Style Selector="Button.tabPill.active">
        <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.tabPill.active:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
    </Style>

    <Style Selector="TextBox.search">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="6,6" />
    </Style>

    <!-- Legend body text inside the help flyout. -->
    <Style Selector="TextBlock.legendText">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="16" />
    </Style>

    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource ColumnHeaderBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style Selector="ToggleSwitch.compact">
        <Setter Property="OnContent" Value="{x:Null}" />
        <Setter Property="OffContent" Value="{x:Null}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</Styles>
