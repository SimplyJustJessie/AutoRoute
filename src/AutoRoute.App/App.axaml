<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AutoRoute.App.App"
             xmlns:local="using:AutoRoute.App"
             RequestedThemeVariant="Dark">
    <!-- AutoRoute is dark-only by design: a routing board is a tool you keep on a second
         monitor next to OBS / a DAW, and those are dark. One variant, no drift. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>

            <!-- ==================== Surfaces (elevation ramp, darkest → lightest) ==================== -->
            <Color x:Key="BgColor">#0F1014</Color>
            <Color x:Key="PanelColor">#14151B</Color>
            <Color x:Key="ColumnColor">#17181F</Color>
            <Color x:Key="ColumnHeaderColor">#1B1C24</Color>
            <Color x:Key="CardColor">#1F212B</Color>
            <Color x:Key="CardHoverColor">#262938</Color>
            <Color x:Key="BorderColor">#282A36</Color>
            <Color x:Key="BorderStrongColor">#343748</Color>

            <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
            <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
            <SolidColorBrush x:Key="ColumnBrush" Color="{StaticResource ColumnColor}" />
            <SolidColorBrush x:Key="ColumnHeaderBrush" Color="{StaticResource ColumnHeaderColor}" />
            <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

            <!-- ==================== Text ==================== -->
            <SolidColorBrush x:Key="TextBrush" Color="#E7E9F1" />
            <SolidColorBrush x:Key="MutedBrush" Color="#9CA1B3" />
            <SolidColorBrush x:Key="FaintBrush" Color="#6C7186" />

            <!-- ==================== State colors ==================== -->
            <!-- Managed = accent (a saved Rule at work). Unsaved = amber (needs a decision).
                 Manual = neutral (kept as-is). Protected = violet (hands off). -->
            <SolidColorBrush x:Key="AccentBrush" Color="#7C9AFF" />
            <SolidColorBrush x:Key="AccentDimBrush" Color="#2E7C9AFF" />
            <SolidColorBrush x:Key="AccentFaintBrush" Color="#177C9AFF" />
            <SolidColorBrush x:Key="UnsavedBrush" Color="#E8B04B" />
            <SolidColorBrush x:Key="UnsavedDimBrush" Color="#2EE8B04B" />
            <SolidColorBrush x:Key="ManualBrush" Color="#8B94AA" />
            <SolidColorBrush x:Key="ManualDimBrush" Color="#268B94AA" />
            <SolidColorBrush x:Key="ProtectedBrush" Color="#B49AFA" />
            <SolidColorBrush x:Key="ProtectedDimBrush" Color="#2EB49AFA" />
            <SolidColorBrush x:Key="DangerBrush" Color="#E77681" />
            <SolidColorBrush x:Key="DangerDimBrush" Color="#33E77681" />
            <SolidColorBrush x:Key="OnlineBrush" Color="#5BC98F" />
            <SolidColorBrush x:Key="DropHighlightBrush" Color="#7C9AFF" />

            <LinearGradientBrush x:Key="LogoBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#8FA8FF" />
                <GradientStop Offset="1" Color="#6D5EF0" />
            </LinearGradientBrush>

            <!-- ==================== Icon geometries (16×16 grid) ====================
                 Glyphs from Bootstrap Icons (https://icons.getbootstrap.com), MIT licensed —
                 see Assets/ICONS-LICENSE.txt. Native 16×16 viewBox, so the path data drops in
                 unchanged. Each is prefixed F1 (non-zero fill rule) to match how the source SVGs
                 are authored — this is what carves the holes in the gear, headphones and search. -->
            <StreamGeometry x:Key="IconLock">F1 M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2m3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2</StreamGeometry>
            <StreamGeometry x:Key="IconUnlock">F1 M11 1a2 2 0 0 0-2 2v4a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h5V3a3 3 0 0 1 6 0v4a.5.5 0 0 1-1 0V3a2 2 0 0 0-2-2</StreamGeometry>
            <StreamGeometry x:Key="IconClose">F1 M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z</StreamGeometry>
            <StreamGeometry x:Key="IconCheck">F1 M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425z</StreamGeometry>
            <StreamGeometry x:Key="IconSearch">F1 M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0</StreamGeometry>
            <StreamGeometry x:Key="IconWave">F1 M8.5 2a.5.5 0 0 1 .5.5v11a.5.5 0 0 1-1 0v-11a.5.5 0 0 1 .5-.5m-2 2a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5m4 0a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5m-6 1.5A.5.5 0 0 1 5 6v4a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m8 0a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m-10 1A.5.5 0 0 1 3 7v2a.5.5 0 0 1-1 0V7a.5.5 0 0 1 .5-.5m12 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0V7a.5.5 0 0 1 .5-.5</StreamGeometry>
            <StreamGeometry x:Key="IconMic">F1 M5 3a3 3 0 0 1 6 0v5a3 3 0 0 1-6 0z M3.5 6.5A.5.5 0 0 1 4 7v1a4 4 0 0 0 8 0V7a.5.5 0 0 1 1 0v1a5 5 0 0 1-4.5 4.975V15h3a.5.5 0 0 1 0 1h-7a.5.5 0 0 1 0-1h3v-2.025A5 5 0 0 1 3 8V7a.5.5 0 0 1 .5-.5</StreamGeometry>
            <StreamGeometry x:Key="IconHeadphones">F1 M8 3a5 5 0 0 0-5 5v1h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V8a6 6 0 1 1 12 0v5a1 1 0 0 1-1 1h-1a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1V8a5 5 0 0 0-5-5</StreamGeometry>
            <StreamGeometry x:Key="IconSpeaker">F1 M11.536 14.01A8.47 8.47 0 0 0 14.026 8a8.47 8.47 0 0 0-2.49-6.01l-.708.707A7.48 7.48 0 0 1 13.025 8c0 2.071-.84 3.946-2.197 5.303z M10.121 12.596A6.48 6.48 0 0 0 12.025 8a6.48 6.48 0 0 0-1.904-4.596l-.707.707A5.48 5.48 0 0 1 11.025 8a5.48 5.48 0 0 1-1.61 3.89z M8.707 11.182A4.5 4.5 0 0 0 10.025 8a4.5 4.5 0 0 0-1.318-3.182L8 5.525A3.5 3.5 0 0 1 9.025 8 3.5 3.5 0 0 1 8 10.475z M6.717 3.55A.5.5 0 0 1 7 4v8a.5.5 0 0 1-.812.39L3.825 10.5H1.5A.5.5 0 0 1 1 10V6a.5.5 0 0 1 .5-.5h2.325l2.363-1.89a.5.5 0 0 1 .529-.06</StreamGeometry>
            <StreamGeometry x:Key="IconDrop">M8,2 L8,10.6 M8,10.6 L4.6,7.2 M8,10.6 L11.4,7.2 M3,13 L13,13</StreamGeometry>
            <!-- Window caption glyphs (custom client-side chrome — single-row title bar). -->
            <StreamGeometry x:Key="IconWindowMin">M2.5,7.4 L13.5,7.4 L13.5,8.6 L2.5,8.6 Z</StreamGeometry>
            <StreamGeometry x:Key="IconWindowMax">F0 M2.5,3 L13.5,3 L13.5,13 L2.5,13 Z M4,4.5 L4,11.5 L12,11.5 L12,4.5 Z</StreamGeometry>
            <StreamGeometry x:Key="IconWindowRestore">F0 M5,5 L5,3 L13,3 L13,11 L11,11 M2.5,5.5 L10.5,5.5 L10.5,13 L2.5,13 Z M4,7 L4,11.5 L9,11.5 L9,7 Z</StreamGeometry>
            <StreamGeometry x:Key="IconGear">F1 M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872zM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.858z</StreamGeometry>

            <!-- ==================== Fluent control overrides (dark chrome) ==================== -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#1B1C24" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1F2029" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1F2029" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource BorderStrongColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#7C9AFF" />
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#6C7186" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#9CA1B3" />
            <SolidColorBrush x:Key="ToolTipBackground" Color="#262938" />
            <SolidColorBrush x:Key="ToolTipForeground" Color="#E7E9F1" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#343748" />
            <CornerRadius x:Key="ControlCornerRadius">7</CornerRadius>

        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AutoRoute.App/Styles/CardStyles.axaml" />
    </Application.Styles>
</Application>
