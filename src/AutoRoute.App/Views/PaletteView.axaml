<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AutoRoute.App.ViewModels"
             xmlns:views="using:AutoRoute.App.Views"
             xmlns:controls="using:AutoRoute.App.Controls"
             xmlns:behaviors="using:AutoRoute.App.Behaviors"
             xmlns:design="using:AutoRoute.App.Design"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="560"
             x:Class="AutoRoute.App.Views.PaletteView"
             x:DataType="vm:SourcesPaletteViewModel"
             d:DataContext="{x:Static design:DesignData.Palette}">

    <!-- Comfortable layout's sources sidebar: apps and inputs, each draggable onto an output row,
         each with its own volume. Margin on the content, not ScrollViewer.Padding (padding sits
         outside the content measure, so long names spilled past the edge). -->
    <Panel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}" Margin="10,10,10,14">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SourceItemViewModel">
                        <StackPanel IsVisible="{Binding IsVisible}">
                            <TextBlock Classes="groupHeader" Text="{Binding GroupLabel}"
                                       IsVisible="{Binding ShowGroupHeader}" Margin="8,10,0,4" />
                            <Border Classes="srcEntry"
                                    behaviors:DragSourceBehavior.SourceNodeId="{Binding RepresentativeNodeId}"
                                    behaviors:DragSourceBehavior.DragLabel="{Binding Title}"
                                    ToolTip.Tip="{Binding Subtitle}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Panel VerticalAlignment="Top" Margin="0,2,12,0">
                                        <Border Classes="tile" Background="{Binding TileBrush}">
                                            <Panel>
                                                <TextBlock Classes="tileLetter" Text="{Binding Initials}" IsVisible="{Binding IsLetterTile}" />
                                                <Path Classes="glyph" IsVisible="{Binding !IsLetterTile}"
                                                      Data="{Binding Glyph, Converter={x:Static views:GlyphConverter.Instance}}" />
                                            </Panel>
                                        </Border>
                                        <Border Classes="badge">
                                            <Border>
                                                <Panel>
                                                    <Path Data="{StaticResource BadgeIn}" IsVisible="{Binding IsInput}" />
                                                    <Path Data="{StaticResource BadgeOut}" IsVisible="{Binding !IsInput}" />
                                                </Panel>
                                            </Border>
                                        </Border>
                                    </Panel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="nm" Text="{Binding Title}" />
                                            <Ellipse Grid.Column="1" Classes="playing" Margin="8,0,2,0"
                                                     IsVisible="{Binding IsRunning}" ToolTip.Tip="Playing" />
                                        </Grid>
                                        <WrapPanel>
                                            <TextBlock Classes="typeLine" Text="{Binding TypeLine}" MaxWidth="200" Margin="0,0,8,2"
                                                       IsVisible="{Binding TypeLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <Border Classes="fmt" Margin="0,0,0,2" IsVisible="{Binding Format, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="{Binding Format}" />
                                            </Border>
                                        </WrapPanel>
                                        <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasVolume}" Margin="-6,0,0,0">
                                            <Button Classes="mute" Classes.on="{Binding IsMuted}"
                                                    Command="{Binding ToggleMuteCommand}" ToolTip.Tip="Mute">
                                                <Panel>
                                                    <Path Data="{StaticResource StrokeVolume}" IsVisible="{Binding !IsMuted}" />
                                                    <Path Data="{StaticResource StrokeMuted}" IsVisible="{Binding IsMuted}" />
                                                </Panel>
                                            </Button>
                                            <controls:Fader Grid.Column="1" Value="{Binding Volume}" IsMuted="{Binding IsMuted}"
                                                            AutomationProperties.Name="{Binding Title, StringFormat='{}{0} volume'}" />
                                            <TextBlock Grid.Column="2" Classes="pct" Text="{Binding VolumePercent}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Classes="hint" VerticalAlignment="Center" HorizontalAlignment="Center"
                   IsVisible="{Binding IsEmpty}" Text="Nothing playing" />
    </Panel>
</UserControl>
