<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AutoRoute.App.ViewModels"
             xmlns:views="using:AutoRoute.App.Views"
             xmlns:behaviors="using:AutoRoute.App.Behaviors"
             xmlns:design="using:AutoRoute.App.Design"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="560"
             x:Class="AutoRoute.App.Views.PaletteView"
             x:DataType="vm:SourcesPaletteViewModel"
             d:DataContext="{x:Static design:DesignData.Palette}">

    <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Margin="14,14,14,10" Spacing="4">
            <TextBlock Classes="sectionLabel" Text="SOURCES" />
            <TextBlock Classes="subtitle" TextWrapping="Wrap" LineHeight="16"
                       Text="Drag onto a Target Sink to route. Cards stay here — one Source can feed many sinks." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="14,0,14,14"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SourceItemViewModel">
                        <Border Classes="paletteItem"
                                Classes.protected="{Binding IsProtected}"
                                IsVisible="{Binding IsVisible}"
                                behaviors:DragSourceBehavior.SourceNodeId="{Binding RepresentativeNodeId}"
                                ToolTip.Tip="Drag onto a Target Sink to route this Source">
                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <!-- Kind tile: tinted icon (app / capture / monitor) -->
                                <Border Grid.Column="0" Classes="kindTile"
                                        Classes.app="{Binding IsAppKind}"
                                        Classes.capture="{Binding IsCaptureKind}"
                                        Classes.monitor="{Binding IsMonitorKind}"
                                        Margin="0,0,10,0"
                                        ToolTip.Tip="{Binding KindLabel}">
                                    <Panel>
                                        <Path Data="{StaticResource IconWave}" IsVisible="{Binding IsAppKind}" />
                                        <Path Data="{StaticResource IconMic}" IsVisible="{Binding IsCaptureKind}" />
                                        <Path Data="{StaticResource IconHeadphones}" IsVisible="{Binding IsMonitorKind}" />
                                    </Panel>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Classes="cardTitle" Text="{Binding Title}" />
                                    <TextBlock Classes="subtitle" Text="{Binding Subtitle}"
                                               IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>

                                <Button Grid.Column="2" Classes="icon" Margin="6,0,0,0"
                                        Classes.locked="{Binding IsProtected}"
                                        Command="{Binding ToggleProtectCommand}"
                                        ToolTip.Tip="Protect / unprotect this Source (do not touch)">
                                    <Panel>
                                        <Path Data="{StaticResource IconUnlock}" IsVisible="{Binding !IsProtected}" />
                                        <Path Data="{StaticResource IconLock}" IsVisible="{Binding IsProtected}" />
                                    </Panel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Classes="hint" VerticalAlignment="Center"
                   IsVisible="{Binding IsEmpty}" Text="No Sources in the graph." />
    </Grid>
</UserControl>
