<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AutoRoute.App.ViewModels"
             xmlns:views="using:AutoRoute.App.Views"
             xmlns:behaviors="using:AutoRoute.App.Behaviors"
             xmlns:design="using:AutoRoute.App.Design"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="640"
             x:Class="AutoRoute.App.Views.BoardView"
             x:DataType="vm:BoardViewModel"
             d:DataContext="{x:Static design:DesignData.Board}">

    <!-- AllowDrop on the root keeps DragOver events flowing over the whole board, so the
         drag ghost can follow the pointer between columns (drops outside a column are no-ops). -->
    <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource BgBrush}"
          DragDrop.AllowDrop="True">

        <!-- ===================== Toolbar / title bar =====================
             Doubles as the window's title bar (client-side decorations, see MainWindow.axaml):
             drag it to move the window, double-click to maximise/restore. -->
        <Border Grid.Row="0" Classes="panel" BorderThickness="0,0,0,1" Padding="14,10"
                Name="TitleBar"
                PointerPressed="OnTitleBarPointerPressed"
                DoubleTapped="OnTitleBarDoubleTapped">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Brand + status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Classes="logoMark">
                        <Path Data="{StaticResource IconWave}" Fill="#F2F4FF"
                              Width="14" Height="14" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Classes="body" Text="AutoRoute" FontWeight="Bold" FontSize="15"
                               VerticalAlignment="Center" />
                    <Border Classes="statusPill">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource OnlineBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Classes="subtitle" Text="{Binding StatusText}" FontSize="11.5"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Audio/Video switcher: Tabs is the same TabSelectionState instance on both
                         boards (see BoardViewModel.Tabs), so this is a plain binding off this board's
                         own DataContext — no reaching into a sibling view or the Window. Both boards
                         render this identically; only the visible one is ever shown. -->
                    <Border Classes="tabPillGroup" Margin="4,0,0,0" IsVisible="{Binding Tabs, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="tabPill" Content="Audio"
                                    Classes.active="{Binding Tabs.IsAudioSelected}"
                                    Command="{Binding Tabs.SelectAudioCommand}" />
                            <Button Classes="tabPill" Content="Video"
                                    Classes.active="{Binding Tabs.IsVideoSelected}"
                                    Command="{Binding Tabs.SelectVideoCommand}"
                                    ToolTip.Tip="Route Spout2PW / OBS video nodes — e.g. keep VTube Studio connected to OBS" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Filter -->
                <TextBox Grid.Column="1" Classes="search"
                         Margin="20,0" MaxWidth="380" HorizontalAlignment="Stretch"
                         Watermark="Filter Sources and Target Sinks…"
                         Text="{Binding Filter.Text}">
                    <TextBox.InnerLeftContent>
                        <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource FaintBrush}"
                              Width="13" Height="13" Stretch="Uniform"
                              Margin="10,0,2,0" VerticalAlignment="Center" />
                    </TextBox.InnerLeftContent>
                </TextBox>

                <!-- New sink + monitors toggle + help -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="chipAction" Name="NewSinkButton"
                            IsVisible="{Binding CanManageSinks}"
                            Content="+ New Sink"
                            ToolTip.Tip="Create a virtual (null) sink — it persists across reboots via a generated PipeWire config">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="300" Spacing="10" Margin="6">
                                    <TextBlock Classes="sectionLabel" Text="NEW VIRTUAL SINK" />
                                    <TextBox Watermark="Name (e.g. StreamSink)"
                                             Text="{Binding NewSinkName}" />
                                    <TextBox Watermark="Description (defaults to name)"
                                             Text="{Binding NewSinkDescription}" />
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <RadioButton GroupName="NewSinkChannels" Content="Stereo"
                                                     IsChecked="{Binding !NewSinkMono}" />
                                        <RadioButton GroupName="NewSinkChannels" Content="Mono"
                                                     IsChecked="{Binding NewSinkMono}" />
                                    </StackPanel>
                                    <TextBlock Classes="legendText" TextWrapping="Wrap"
                                               Foreground="{DynamicResource UnsavedBrush}"
                                               Text="{Binding NewSinkValidationMessage}"
                                               IsVisible="{Binding NewSinkValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <Button Classes="chipAction" HorizontalAlignment="Right"
                                            Content="Create"
                                            Command="{Binding SubmitNewSinkCommand}"
                                            Click="OnCreateSinkClick" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <TextBlock Classes="subtitle" Text="Sink monitors" FontSize="12"
                               VerticalAlignment="Center" />
                    <ToggleSwitch Classes="compact" IsChecked="{Binding Filter.ShowMonitors}"
                                  ToolTip.Tip="Show each sink's monitor as a draggable Source" />

                    <!-- Autostart: set AutoRoute to start at login, self-detecting its own path. -->
                    <Button Classes="icon" Name="AutostartButton"
                            IsVisible="{Binding CanManageAutostart}"
                            ToolTip.Tip="Start AutoRoute automatically at login">
                        <Path Data="{StaticResource IconGear}" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="320" Spacing="10" Margin="6"
                                            DataContext="{Binding Autostart}">
                                    <TextBlock Classes="sectionLabel" Text="START AT LOGIN" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="body" VerticalAlignment="Center"
                                                   Text="Start AutoRoute when I log in" />
                                        <ToggleSwitch Grid.Column="1" Classes="compact"
                                                      IsChecked="{Binding IsEnabled}"
                                                      IsEnabled="{Binding !IsBusy}" />
                                    </Grid>
                                    <TextBlock Classes="legendText" TextWrapping="Wrap"
                                               Foreground="{DynamicResource FaintBrush}"
                                               Text="{Binding LaunchTarget, StringFormat='Launches: {0} --background'}" />
                                    <TextBlock Classes="legendText" TextWrapping="Wrap"
                                               Foreground="{DynamicResource UnsavedBrush}"
                                               Text="{Binding StatusMessage}"
                                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Updates: check the Gitea release for a newer AppImage and self-replace. -->
                    <Button Classes="icon" Name="UpdatesButton"
                            IsVisible="{Binding CanCheckUpdates}"
                            ToolTip.Tip="Check for AutoRoute updates">
                        <Path Data="{StaticResource IconDownload}" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="320" Spacing="10" Margin="6"
                                            DataContext="{Binding Update}">
                                    <TextBlock Classes="sectionLabel" Text="UPDATES" />
                                    <TextBlock Classes="body"
                                               Text="{Binding CurrentVersion, StringFormat='Current version: {0}'}" />

                                    <Button Classes="chipAction" HorizontalAlignment="Left"
                                            Content="Check for updates"
                                            Command="{Binding CheckCommand}"
                                            IsEnabled="{Binding !IsBusy}"
                                            IsVisible="{Binding CanSelfUpdate}" />

                                    <Button Classes="chipAction" HorizontalAlignment="Left"
                                            Content="{Binding LatestVersion, StringFormat='Download and install {0}'}"
                                            Command="{Binding InstallCommand}"
                                            IsEnabled="{Binding !IsBusy}"
                                            IsVisible="{Binding UpdateAvailable}" />

                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}"
                                                 IsVisible="{Binding IsBusy}" />

                                    <Button Classes="chipAction" HorizontalAlignment="Left"
                                            Content="Restart now"
                                            Command="{Binding RestartCommand}"
                                            IsVisible="{Binding NeedsRestart}" />

                                    <TextBlock Classes="legendText" TextWrapping="Wrap"
                                               Foreground="{DynamicResource FaintBrush}"
                                               Text="{Binding StatusMessage}"
                                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Classes="icon" Name="HelpButton" Margin="4,0,0,0"
                            ToolTip.Tip="What do the card states mean?">
                        <Border Classes="helpBadge">
                            <TextBlock Text="?" />
                        </Border>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="330" Spacing="12" Margin="6">
                                    <TextBlock Classes="sectionLabel" Text="CARD STATES" />

                                    <Grid ColumnDefinitions="84,*">
                                        <Border Classes="chip managed" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="MANAGED" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Classes="legendText"
                                                   Text="Saved as a Rule. AutoRoute re-creates this Link automatically whenever the matching apps come back — it survives relaunches." />
                                    </Grid>

                                    <Grid ColumnDefinitions="84,*">
                                        <Border Classes="chip unsaved" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="UNSAVED" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Classes="legendText"
                                                   Text="A Link made outside AutoRoute. It works now, but it won't come back after a relaunch — Save it as a Rule, or Keep it as manual." />
                                    </Grid>

                                    <Grid ColumnDefinitions="84,*">
                                        <Border Classes="chip manual" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="MANUAL" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Classes="legendText"
                                                   Text="Kept as-is. AutoRoute leaves this Link alone and won't restore it if it disappears." />
                                    </Grid>

                                    <Grid ColumnDefinitions="84,*">
                                        <Border Classes="chip protected" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="PROTECTED" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Classes="legendText"
                                                   Text="Do not touch. AutoRoute never creates or removes Links on this node — for routing another tool owns (e.g. an EasyEffects chain)." />
                                    </Grid>

                                    <TextBlock Classes="legendText" Foreground="{DynamicResource FaintBrush}"
                                               Text="Removing a card deletes its Rule (managed) or suppresses the Link so it stays disconnected (manual / unsaved)." />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Window caption controls (client-side chrome). -->
                    <Border Classes="captionSep" />
                    <Button Classes="icon caption" Name="MinimizeButton" Margin="2,0,0,0"
                            Click="OnMinimizeClick" ToolTip.Tip="Minimize">
                        <!-- Fixed centered size (inline, so it beats the shared Button.icon Path
                             style): the min glyph is a wide, ultra-thin bar and Uniform stretch would
                             top-align it, leaving the dash high vs. the maximize/close glyphs. -->
                        <Path Data="{StaticResource IconWindowMin}" Stretch="Fill"
                              Width="11" Height="1.4"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Classes="icon caption" Name="MaximizeButton"
                            Click="OnMaximizeClick" ToolTip.Tip="Maximize">
                        <Path Name="MaximizeIcon" Data="{StaticResource IconWindowMax}" />
                    </Button>
                    <Button Classes="icon caption danger" Name="CloseButton"
                            Click="OnCloseClick" ToolTip.Tip="Close">
                        <Path Data="{StaticResource IconClose}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1 notice banners (each self-hides when empty). -->
        <StackPanel Grid.Row="1">

            <!-- Update available: a newer release is out (in-app updater, AppImage self-replace). -->
            <Border Classes="panel" BorderThickness="0,0,0,1" Padding="14,8"
                    IsVisible="{Binding HasUpdateNotice}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="legendText" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource UnsavedBrush}"
                               Text="{Binding UpdateNoticeText}" />
                    <Button Grid.Column="1" Classes="chipAction" Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Content="Update"
                            Command="{Binding InstallUpdateCommand}"
                            ToolTip.Tip="Download, verify, and install the new version — then restart to finish" />
                </Grid>
            </Border>

            <!-- Legacy static-conf notice (ADR-0011, revised: detect + offer — import only on click) -->
            <Border Classes="panel" BorderThickness="0,0,0,1" Padding="14,8"
                    IsVisible="{Binding HasLegacyNotice}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="legendText" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource UnsavedBrush}"
                               Text="{Binding LegacyNoticeText}" />
                    <Button Grid.Column="1" Classes="chipAction" Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding HasPendingLegacyImport}"
                            Content="Import into AutoRoute"
                            Command="{Binding ImportLegacySinksCommand}"
                            ToolTip.Tip="Declare these sinks in AutoRoute so they get the VIRTUAL treatment — nothing is imported until you click" />
                </Grid>
            </Border>

        </StackPanel>

        <!-- ===================== Palette + Board ===================== -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*">

            <!-- ClipToBounds: whatever a future layout regression measures wrong, nothing from
                 the palette may paint over the board. -->
            <Border Grid.Column="0" Classes="panel" BorderThickness="0,0,1,0" Width="280"
                    ClipToBounds="True">
                <views:PaletteView DataContext="{Binding Palette}" />
            </Border>

            <Panel Grid.Column="1">
                <!-- AllowAutoHide=False: the board scrollbar is a primary control here, not a
                     transient indicator — always full-size instead of the hover-to-expand rail. -->
                <ScrollViewer Classes="boardScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              AllowAutoHide="False">
                    <!-- Margin on the content (not ScrollViewer.Padding) so the scroll extent
                         includes it and the last column is fully reachable. -->
                    <ItemsControl ItemsSource="{Binding Columns}" Margin="16,16,16,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SinkColumnViewModel">
                                <views:SinkColumnView IsVisible="{Binding IsVisible}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Spacing="10" MaxWidth="380"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding !HasColumns}">
                    <Path Data="{StaticResource IconSpeaker}" Fill="{DynamicResource FaintBrush}"
                          Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" />
                    <TextBlock Classes="hint" Text="{Binding EmptyStateHint}" />
                </StackPanel>
            </Panel>
        </Grid>

        <!-- ===================== Resize grips (client-side chrome) =====================
             SystemDecorations="None" removes the native resize border along with the title bar, so
             these thin transparent strips over the window edges + corners restore drag-to-resize
             via BeginResizeDrag. They sit on top (declared last, spanning every row) but only cover
             the outermost few pixels, so they don't block the UI. Corners come after edges so the
             diagonal grip wins in the overlap. -->
        <Border Grid.RowSpan="3" Name="ResizeN" Tag="North" Background="Transparent"
                Height="4" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                Cursor="TopSide" PointerPressed="OnResizePointerPressed" />
        <Border Grid.RowSpan="3" Name="ResizeS" Tag="South" Background="Transparent"
                Height="4" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                Cursor="BottomSide" PointerPressed="OnResizePointerPressed" />
        <Border Grid.RowSpan="3" Name="ResizeW" Tag="West" Background="Transparent"
                Width="4" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                Cursor="LeftSide" PointerPressed="OnResizePointerPressed" />
        <Border Grid.RowSpan="3" Name="ResizeE" Tag="East" Background="Transparent"
                Width="4" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Cursor="RightSide" PointerPressed="OnResizePointerPressed" />
        <Border Grid.RowSpan="3" Name="ResizeNW" Tag="NorthWest" Background="Transparent"
                Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                Cursor="TopLeftCorner" PointerPressed="OnResizePointerPressed" />
        <Border Grid.RowSpan="3" Name="ResizeNE" Tag="NorthEast" Background="Transparent"
                Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                Cursor="TopRightCorner" PointerPressed="OnResizePointerPressed" />
        <Border Grid.RowSpan="3" Name="ResizeSW" Tag="SouthWest" Background="Transparent"
                Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Cursor="BottomLeftCorner" PointerPressed="OnResizePointerPressed" />
        <Border Grid.RowSpan="3" Name="ResizeSE" Tag="SouthEast" Background="Transparent"
                Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Cursor="BottomRightCorner" PointerPressed="OnResizePointerPressed" />
    </Grid>
</UserControl>
