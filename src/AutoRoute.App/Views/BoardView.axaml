<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AutoRoute.App.ViewModels"
             xmlns:views="using:AutoRoute.App.Views"
             xmlns:behaviors="using:AutoRoute.App.Behaviors"
             xmlns:design="using:AutoRoute.App.Design"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="640"
             x:Class="AutoRoute.App.Views.BoardView"
             x:DataType="vm:BoardViewModel"
             d:DataContext="{x:Static design:DesignData.Board}">

    <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource BgBrush}">

        <!-- ===================== Top bar (doubles as the title bar) =====================
             Drag it to move the window, double-click to maximise. No wordmark: the window
             manager already names the app, and the space goes to search. -->
        <Border Grid.Row="0" Classes="panel" BorderThickness="0,0,0,1" Padding="12,8,8,8"
                Name="TitleBar"
                PointerPressed="OnTitleBarPointerPressed"
                DoubleTapped="OnTitleBarDoubleTapped">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Audio/Video switcher (the TabSelectionState is shared by both boards). -->
                <Border Grid.Column="0" Classes="tabPillGroup" VerticalAlignment="Center"
                        IsVisible="{Binding Tabs, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="tabPill" Content="Audio"
                                Classes.active="{Binding Tabs.IsAudioSelected}"
                                Command="{Binding Tabs.SelectAudioCommand}" />
                        <Button Classes="tabPill" Content="Video"
                                Classes.active="{Binding Tabs.IsVideoSelected}"
                                Command="{Binding Tabs.SelectVideoCommand}" />
                    </StackPanel>
                </Border>

                <TextBox Grid.Column="1" Classes="search"
                         Margin="12,0" MaxWidth="380" HorizontalAlignment="Left"
                         Width="380"
                         PlaceholderText="Search"
                         Text="{Binding Filter.Text}">
                    <TextBox.InnerLeftContent>
                        <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource FaintBrush}"
                              Width="13" Height="13" Stretch="Uniform"
                              Margin="10,0,2,0" VerticalAlignment="Center" />
                    </TextBox.InnerLeftContent>
                </TextBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                    <!-- Window caption controls (client-side chrome). -->
                    <Border Classes="captionSep" />
                    <Button Classes="icon caption" Name="MinimizeButton" Margin="2,0,0,0"
                            Click="OnMinimizeClick" ToolTip.Tip="Minimize">
                        <Path Data="{StaticResource IconWindowMin}" Stretch="Fill"
                              Width="11" Height="1.4"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Classes="icon caption" Name="MaximizeButton"
                            Click="OnMaximizeClick" ToolTip.Tip="Maximize">
                        <Path Name="MaximizeIcon" Data="{StaticResource IconWindowMax}" />
                    </Button>
                    <Button Classes="icon caption danger" Name="CloseButton"
                            Click="OnCloseClick" ToolTip.Tip="Close">
                        <Path Data="{StaticResource IconClose}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Notice banners (each self-hides when empty). -->
        <StackPanel Grid.Row="1">
            <Border Classes="panel" BorderThickness="0,0,0,1" Padding="14,8"
                    IsVisible="{Binding HasUpdateNotice}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="legendText" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource UnsavedBrush}"
                               Text="{Binding UpdateNoticeText}" />
                    <Button Grid.Column="1" Classes="chipAction" Margin="12,0,0,0"
                            VerticalAlignment="Center" Content="Update"
                            Command="{Binding InstallUpdateCommand}"
                            IsVisible="{Binding CanInstallUpdate}" />
                </Grid>
            </Border>
            <Border Classes="panel" BorderThickness="0,0,0,1" Padding="14,8"
                    IsVisible="{Binding HasLegacyNotice}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="legendText" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource UnsavedBrush}"
                               Text="{Binding LegacyNoticeText}" />
                    <Button Grid.Column="1" Classes="chipAction" Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding HasPendingLegacyImport}"
                            Content="Import"
                            Command="{Binding ImportLegacySinksCommand}" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- ===================== Sources + outputs =====================
             Comfortable: sources sidebar | output rows.
             Compact: output rows over a sources tray. Same view models either way. -->
        <!-- Column 0 width is driven from code-behind: the remembered sidebar width, or 0 in
             Compact. The splitter on its edge resizes it. -->
        <Grid Grid.Row="2" Name="BodyGrid" RowDefinitions="*,Auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="0" MaxWidth="560" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Grid.Row="0" Classes="panel" BorderThickness="0,0,1,0"
                    ClipToBounds="True" IsVisible="{Binding !Ui.IsCompact}">
                <views:PaletteView DataContext="{Binding Palette}" />
            </Border>

            <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Name="SidebarSplitter" Width="5"
                          Background="Transparent" ResizeDirection="Columns"
                          IsVisible="{Binding !Ui.IsCompact}"
                          DragCompleted="OnSidebarResized" />

            <Panel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Name="MainArea">
                <ScrollViewer Name="BoardScroll" behaviors:SmoothScroll.IsEnabled="True"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Columns}" Margin="0,6,0,20">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SinkColumnViewModel">
                                <views:SinkColumnView IsVisible="{Binding IsVisible}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Spacing="10" MaxWidth="380"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding !HasColumns}">
                    <Path Data="{StaticResource IconSpeaker}" Fill="{DynamicResource FaintBrush}"
                          Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" />
                    <TextBlock Classes="hint" Text="{Binding EmptyStateHint}" />
                </StackPanel>

                <!-- Soft bottom edge: rows scroll away under a fade instead of being sliced off
                     at the window edge. Stops short of the scrollbar. -->
                <Border Height="36" VerticalAlignment="Bottom" Margin="0,0,14,0" IsHitTestVisible="False"
                        Background="{DynamicResource ListFadeBottomBrush}" />

                <!-- Undo toast: the last removal can be taken back for a few seconds. -->
                <Border Classes="toast" IsVisible="{Binding HasToast}"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="toastText" Text="{Binding ToastText}" />
                        <Button Classes="toastUndo" Content="Undo" Command="{Binding UndoCommand}" />
                        <Button Classes="mini" Command="{Binding DismissToastCommand}" ToolTip.Tip="Dismiss">
                            <Path Data="{StaticResource StrokeX}" />
                        </Button>
                    </StackPanel>
                </Border>
            </Panel>

            <!-- Bottom bar: under the sidebar in Comfortable (like a chat app's user panel), full
                 width in Compact where it also carries the sources tray. Placement is set from
                 code-behind (ApplyLayout). -->
            <Border Grid.Column="0" Grid.Row="1" Name="BottomBar" Classes="panel" BorderThickness="0,1,1,0">
                <Grid ColumnDefinitions="*,Auto">
                    <Panel Grid.Column="0" IsVisible="{Binding Ui.IsCompact}">
                        <views:SourceTrayView DataContext="{Binding Palette}" />
                    </Panel>
                    <Grid Grid.Column="1" Name="Actions" ColumnDefinitions="*,Auto,Auto"
                          Margin="12,10" VerticalAlignment="Center">
                            <Button Grid.Column="0" Classes="primary" Name="NewSinkButton"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    IsVisible="{Binding CanManageSinks}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Data="{StaticResource StrokePlus}" VerticalAlignment="Center" />
                                    <TextBlock Text="Virtual sink" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="TopEdgeAlignedLeft">
                                        <StackPanel Width="300" Spacing="10" Margin="6">
                                            <TextBox PlaceholderText="Name (e.g. Game)" Text="{Binding NewSinkName}" />
                                            <TextBox PlaceholderText="Label (optional)" Text="{Binding NewSinkDescription}" />
                                            <StackPanel Orientation="Horizontal" Spacing="14">
                                                <RadioButton GroupName="NewSinkChannels" Content="Stereo"
                                                             IsChecked="{Binding !NewSinkMono}" />
                                                <RadioButton GroupName="NewSinkChannels" Content="Mono"
                                                             IsChecked="{Binding NewSinkMono}" />
                                            </StackPanel>
                                            <TextBlock Classes="legendText" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource UnsavedBrush}"
                                                       Text="{Binding NewSinkValidationMessage}"
                                                       IsVisible="{Binding NewSinkValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <Button Classes="chipAction" HorizontalAlignment="Right"
                                                    Content="Create"
                                                    Command="{Binding SubmitNewSinkCommand}"
                                                    Click="OnCreateSinkClick" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <!-- Settings: layout density, sink monitors, start at login. -->
                            <Button Grid.Column="1" Classes="icon" Name="SettingsButton" Margin="6,0,0,0" ToolTip.Tip="Settings">
                                <Path Data="{StaticResource IconGear}" />
                                <Button.Flyout>
                                    <Flyout Placement="TopEdgeAlignedLeft">
                                        <StackPanel Width="300" Spacing="12" Margin="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Classes="body" VerticalAlignment="Center" Text="Compact layout" />
                                                <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding Ui.IsCompact}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Classes="body" VerticalAlignment="Center" Text="Show sink monitors as sources"
                                                           TextWrapping="Wrap" />
                                                <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding Filter.ShowMonitors}" />
                                            </Grid>
                                            <Panel IsVisible="{Binding CanManageAutostart}">
                                                <StackPanel Spacing="8" DataContext="{Binding Autostart}">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="body" VerticalAlignment="Center" Text="Start at login" />
                                                        <ToggleSwitch Grid.Column="1" Classes="compact"
                                                                      IsChecked="{Binding IsEnabled}"
                                                                      IsEnabled="{Binding !IsBusy}" />
                                                    </Grid>
                                                    <TextBlock Classes="legendText" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource UnsavedBrush}"
                                                               Text="{Binding StatusMessage}"
                                                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                            </Panel>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <!-- Updates (AppImage self-replace). -->
                            <Button Grid.Column="2" Classes="icon" Name="UpdatesButton" Margin="2,0,0,0"
                                    IsVisible="{Binding CanCheckUpdates}"
                                    ToolTip.Tip="Updates">
                                <Path Data="{StaticResource IconDownload}" />
                                <Button.Flyout>
                                    <Flyout Placement="TopEdgeAlignedLeft">
                                        <StackPanel Width="300" Spacing="10" Margin="6"
                                                    DataContext="{Binding Update}">
                                            <TextBlock Classes="body"
                                                       Text="{Binding CurrentVersion, StringFormat='Version {0}'}" />
                                            <Button Classes="chipAction" HorizontalAlignment="Left"
                                                    Content="Check for updates"
                                                    Command="{Binding CheckCommand}"
                                                    IsEnabled="{Binding !IsBusy}" />
                                            <Button Classes="chipAction" HorizontalAlignment="Left"
                                                    Content="{Binding LatestVersion, StringFormat='Install {0}'}"
                                                    Command="{Binding InstallCommand}"
                                                    IsEnabled="{Binding !IsBusy}"
                                                    IsVisible="{Binding CanInstall}" />
                                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}"
                                                         IsVisible="{Binding IsBusy}" />
                                            <Button Classes="chipAction" HorizontalAlignment="Left"
                                                    Content="Restart now"
                                                    Command="{Binding RestartCommand}"
                                                    IsVisible="{Binding NeedsRestart}" />
                                            <TextBlock Classes="legendText" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource FaintBrush}"
                                                       Text="{Binding StatusMessage}"
                                                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== Resize grips (client-side chrome) ===================== -->
        <Border Grid.RowSpan="3" Name="ResizeN" Tag="North" Background="Transparent"
                Height="4" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                Cursor="TopSide" PointerPressed="OnResizePointerPressed" />
        <Border Grid.RowSpan="3" Name="ResizeS" Tag="South" Background="Transparent"
                Height="4" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                Cursor="BottomSide" PointerPressed="OnResizePointerPressed" />
        <Border Grid.RowSpan="3" Name="ResizeW" Tag="West" Background="Transparent"
                Width="4" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                Cursor="LeftSide" PointerPressed="OnResizePointerPressed" />
        <Border Grid.RowSpan="3" Name="ResizeE" Tag="East" Background="Transparent"
                Width="4" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Cursor="RightSide" PointerPressed="OnResizePointerPressed" />
        <Border Grid.RowSpan="3" Name="ResizeNW" Tag="NorthWest" Background="Transparent"
                Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                Cursor="TopLeftCorner" PointerPressed="OnResizePointerPressed" />
        <Border Grid.RowSpan="3" Name="ResizeNE" Tag="NorthEast" Background="Transparent"
                Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                Cursor="TopRightCorner" PointerPressed="OnResizePointerPressed" />
        <Border Grid.RowSpan="3" Name="ResizeSW" Tag="SouthWest" Background="Transparent"
                Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Cursor="BottomLeftCorner" PointerPressed="OnResizePointerPressed" />
        <Border Grid.RowSpan="3" Name="ResizeSE" Tag="SouthEast" Background="Transparent"
                Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Cursor="BottomRightCorner" PointerPressed="OnResizePointerPressed" />
    </Grid>
</UserControl>
