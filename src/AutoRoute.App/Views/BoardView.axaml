<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AutoRoute.App.ViewModels"
             xmlns:views="using:AutoRoute.App.Views"
             xmlns:behaviors="using:AutoRoute.App.Behaviors"
             xmlns:design="using:AutoRoute.App.Design"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="640"
             x:Class="AutoRoute.App.Views.BoardView"
             x:DataType="vm:BoardViewModel"
             d:DataContext="{x:Static design:DesignData.Board}">

    <!-- AllowDrop on the root keeps DragOver events flowing over the whole board, so the
         drag ghost can follow the pointer between columns (drops outside a column are no-ops). -->
    <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource BgBrush}"
          DragDrop.AllowDrop="True">

        <!-- ===================== Toolbar ===================== -->
        <Border Grid.Row="0" Classes="panel" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Brand + status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Classes="logoMark">
                        <Path Data="{StaticResource IconWave}" Fill="#F2F4FF"
                              Width="14" Height="14" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Classes="body" Text="AutoRoute" FontWeight="Bold" FontSize="15"
                               VerticalAlignment="Center" />
                    <Border Classes="statusPill">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource OnlineBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Classes="subtitle" Text="{Binding StatusText}" FontSize="11.5"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Filter -->
                <TextBox Grid.Column="1" Classes="search"
                         Margin="20,0" MaxWidth="380" HorizontalAlignment="Stretch"
                         Watermark="Filter Sources and Target Sinks…"
                         Text="{Binding Filter.Text}">
                    <TextBox.InnerLeftContent>
                        <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource FaintBrush}"
                              Width="13" Height="13" Stretch="Uniform"
                              Margin="10,0,2,0" VerticalAlignment="Center" />
                    </TextBox.InnerLeftContent>
                </TextBox>

                <!-- New sink + monitors toggle + help -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="chipAction" Name="NewSinkButton"
                            IsVisible="{Binding CanManageSinks}"
                            Content="+ New Sink"
                            ToolTip.Tip="Create a virtual (null) sink — it persists across reboots via a generated PipeWire config">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="300" Spacing="10" Margin="6">
                                    <TextBlock Classes="sectionLabel" Text="NEW VIRTUAL SINK" />
                                    <TextBox Watermark="Name (e.g. StreamSink)"
                                             Text="{Binding NewSinkName}" />
                                    <TextBox Watermark="Description (defaults to name)"
                                             Text="{Binding NewSinkDescription}" />
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <RadioButton GroupName="NewSinkChannels" Content="Stereo"
                                                     IsChecked="{Binding !NewSinkMono}" />
                                        <RadioButton GroupName="NewSinkChannels" Content="Mono"
                                                     IsChecked="{Binding NewSinkMono}" />
                                    </StackPanel>
                                    <TextBlock Classes="legendText" TextWrapping="Wrap"
                                               Foreground="{DynamicResource UnsavedBrush}"
                                               Text="{Binding NewSinkValidationMessage}"
                                               IsVisible="{Binding NewSinkValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <Button Classes="chipAction" HorizontalAlignment="Right"
                                            Content="Create"
                                            Command="{Binding SubmitNewSinkCommand}"
                                            Click="OnCreateSinkClick" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <TextBlock Classes="subtitle" Text="Sink monitors" FontSize="12"
                               VerticalAlignment="Center" />
                    <ToggleSwitch Classes="compact" IsChecked="{Binding Filter.ShowMonitors}"
                                  ToolTip.Tip="Show each sink's monitor as a draggable Source" />

                    <Button Classes="icon" Name="HelpButton" Margin="4,0,0,0"
                            ToolTip.Tip="What do the card states mean?">
                        <Border Classes="helpBadge">
                            <TextBlock Text="?" />
                        </Border>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="330" Spacing="12" Margin="6">
                                    <TextBlock Classes="sectionLabel" Text="CARD STATES" />

                                    <Grid ColumnDefinitions="84,*">
                                        <Border Classes="chip managed" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="MANAGED" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Classes="legendText"
                                                   Text="Saved as a Rule. AutoRoute re-creates this Link automatically whenever the matching apps come back — it survives relaunches." />
                                    </Grid>

                                    <Grid ColumnDefinitions="84,*">
                                        <Border Classes="chip unsaved" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="UNSAVED" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Classes="legendText"
                                                   Text="A Link made outside AutoRoute. It works now, but it won't come back after a relaunch — Save it as a Rule, or Keep it as manual." />
                                    </Grid>

                                    <Grid ColumnDefinitions="84,*">
                                        <Border Classes="chip manual" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="MANUAL" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Classes="legendText"
                                                   Text="Kept as-is. AutoRoute leaves this Link alone and won't restore it if it disappears." />
                                    </Grid>

                                    <Grid ColumnDefinitions="84,*">
                                        <Border Classes="chip protected" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="PROTECTED" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Classes="legendText"
                                                   Text="Do not touch. AutoRoute never creates or removes Links on this node — for routing another tool owns (e.g. an EasyEffects chain)." />
                                    </Grid>

                                    <TextBlock Classes="legendText" Foreground="{DynamicResource FaintBrush}"
                                               Text="Removing a card deletes its Rule (managed) or suppresses the Link so it stays disconnected (manual / unsaved)." />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Legacy static-conf notice (ADR-0011, revised: detect + offer — import only on click) -->
        <Border Grid.Row="1" Classes="panel" BorderThickness="0,0,0,1" Padding="14,8"
                IsVisible="{Binding HasLegacyNotice}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="legendText" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource UnsavedBrush}"
                           Text="{Binding LegacyNoticeText}" />
                <Button Grid.Column="1" Classes="chipAction" Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        IsVisible="{Binding HasPendingLegacyImport}"
                        Content="Import into AutoRoute"
                        Command="{Binding ImportLegacySinksCommand}"
                        ToolTip.Tip="Declare these sinks in AutoRoute so they get the VIRTUAL treatment — nothing is imported until you click" />
            </Grid>
        </Border>

        <!-- ===================== Palette + Board ===================== -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*">

            <Border Grid.Column="0" Classes="panel" BorderThickness="0,0,1,0" Width="280">
                <views:PaletteView DataContext="{Binding Palette}" />
            </Border>

            <Panel Grid.Column="1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <!-- Margin on the content (not ScrollViewer.Padding) so the scroll extent
                         includes it and the last column is fully reachable. -->
                    <ItemsControl ItemsSource="{Binding Columns}" Margin="16,16,16,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SinkColumnViewModel">
                                <views:SinkColumnView IsVisible="{Binding IsVisible}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Spacing="10" MaxWidth="380"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding !HasColumns}">
                    <Path Data="{StaticResource IconSpeaker}" Fill="{DynamicResource FaintBrush}"
                          Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" />
                    <TextBlock Classes="hint"
                               Text="No Target Sinks in the graph yet. A Target Sink is any node with audio input ports — a hardware or null sink, or an app's recording stream." />
                </StackPanel>
            </Panel>
        </Grid>
    </Grid>
</UserControl>
