<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AutoRoute.App.ViewModels"
             xmlns:views="using:AutoRoute.App.Views"
             xmlns:design="using:AutoRoute.App.Design"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="AutoRoute.App.Views.SourceCardView"
             x:DataType="vm:SourceCardViewModel"
             d:DataContext="{x:Static design:DesignData.Card}">

    <!-- A source feeding an output, as a chip. Saved = plain; not saved = amber with Keep;
         manual = muted; hands off = lock, no remove. Right-click for the rest. -->
    <Border Classes="chip2"
            Classes.unsaved="{Binding IsUnsaved}"
            Classes.manual="{Binding IsManual}"
            Classes.protected="{Binding IsProtected}">
        <Border.ContextFlyout>
            <MenuFlyout>
                <MenuItem Header="Keep (restore after restart)" Command="{Binding SaveCommand}"
                          IsVisible="{Binding CanSave}" />
                <MenuItem Header="Leave as is (don't restore)" Command="{Binding KeepManualCommand}"
                          IsVisible="{Binding CanKeepManual}" />
                <MenuItem Header="Hands off" Command="{Binding ToggleProtectCommand}"
                          ToggleType="CheckBox" IsChecked="{Binding IsProtected, Mode=OneWay}" />
                <MenuItem Header="Remove" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" />
            </MenuFlyout>
        </Border.ContextFlyout>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Classes="tile chip" Background="{Binding TileBrush}">
                <Panel>
                    <TextBlock Classes="tileLetter" Text="{Binding Initials}" IsVisible="{Binding IsLetterTile}" />
                    <Path Classes="glyph" IsVisible="{Binding !IsLetterTile}"
                          Data="{Binding Glyph, Converter={x:Static views:GlyphConverter.Instance}}" />
                </Panel>
            </Border>
            <Path Data="{StaticResource StrokeLock}" IsVisible="{Binding IsProtected}"
                  Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" Stretch="Uniform"
                  Width="11" Height="11" VerticalAlignment="Center" />
            <TextBlock Classes="chipText" Text="{Binding Title}" />
            <Button Classes="keep" Content="Keep" Command="{Binding SaveCommand}"
                    IsVisible="{Binding CanSave}" />
            <Button Classes="mini" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}"
                    ToolTip.Tip="Remove">
                <Path Data="{StaticResource StrokeX}" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
