<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AutoRoute.App.ViewModels"
             xmlns:views="using:AutoRoute.App.Views"
             xmlns:controls="using:AutoRoute.App.Controls"
             xmlns:behaviors="using:AutoRoute.App.Behaviors"
             xmlns:design="using:AutoRoute.App.Design"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900"
             x:Class="AutoRoute.App.Views.SinkColumnView"
             x:DataType="vm:SinkColumnViewModel"
             d:DataContext="{x:Static design:DesignData.Column}">

    <!-- One output (Target Sink) row: what it is, its volume, and the sources feeding it.
         Comfortable = card with a two-line label; Compact (IsCompact) = dense one-line row. -->
    <StackPanel>
        <TextBlock Classes="groupHeader" Text="{Binding GroupLabel}"
                   IsVisible="{Binding ShowGroupHeader}" Margin="2,14,0,8" />

        <Border Classes="row"
                Classes.compact="{Binding IsCompact}"
                Classes.protected="{Binding IsProtected}"
                behaviors:DropTargetBehavior.DropCommand="{Binding ConnectCommand}"
                behaviors:DropTargetBehavior.AcceptsDrop="{Binding AcceptsDrop}"
                ToolTip.Tip="{Binding Subtitle}">
            <Grid ColumnDefinitions="Auto,230,Auto,Auto,*,Auto">

                <!-- Tile + in/out badge -->
                <Panel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Border Classes="tile" Classes.lg="{Binding !IsCompact}" Classes.sm="{Binding IsCompact}"
                            Background="{Binding TileBrush}">
                        <Panel>
                            <TextBlock Classes="tileLetter" Text="{Binding Initials}" IsVisible="{Binding IsLetterTile}" />
                            <Path Classes="glyph" IsVisible="{Binding !IsLetterTile}"
                                  Data="{Binding Glyph, Converter={x:Static views:GlyphConverter.Instance}}" />
                        </Panel>
                    </Border>
                    <Border Classes="badge">
                        <Border>
                            <Panel>
                                <Path Data="{StaticResource BadgeIn}" IsVisible="{Binding IsInput}" />
                                <Path Data="{StaticResource BadgeOut}" IsVisible="{Binding !IsInput}" />
                            </Panel>
                        </Border>
                    </Border>
                </Panel>

                <!-- Name + type line + format -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="nm" Text="{Binding Title}" MaxWidth="200" />
                        <Ellipse Classes="playing" IsVisible="{Binding IsRunning}" ToolTip.Tip="Playing" />
                    </StackPanel>
                    <WrapPanel IsVisible="{Binding !IsCompact}">
                        <TextBlock Classes="typeLine" Text="{Binding TypeLine}" Margin="0,0,8,2" MaxWidth="200"
                                   IsVisible="{Binding TypeLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <Border Classes="fmt" Margin="0,0,8,2" IsVisible="{Binding Format, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding Format}" />
                        </Border>
                        <Border Classes="tag hands" Margin="0,0,0,2" IsVisible="{Binding IsProtected}">
                            <TextBlock Text="Hands off" />
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- Volume: mute + fader + percent -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                            Width="210" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasVolume}">
                        <Button Classes="mute" Classes.on="{Binding IsMuted}"
                                Command="{Binding ToggleMuteCommand}"
                                ToolTip.Tip="Mute">
                            <Panel>
                                <Path Data="{StaticResource StrokeVolume}" IsVisible="{Binding !IsMuted}" />
                                <Path Data="{StaticResource StrokeMuted}" IsVisible="{Binding IsMuted}" />
                            </Panel>
                        </Button>
                        <controls:Fader Width="140" Value="{Binding Volume}" IsMuted="{Binding IsMuted}"
                                        AutomationProperties.Name="{Binding Title, StringFormat='{}{0} volume'}" />
                        <TextBlock Classes="pct" Text="{Binding VolumePercent}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="3" Classes="feedsDivider" />

                <!-- Sources feeding this output -->
                <WrapPanel Grid.Column="4" Margin="12,8,0,0" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SourceCardViewModel">
                                <views:SourceCardView IsVisible="{Binding IsVisible}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Classes="addChip" Name="AddButton" IsVisible="{Binding AcceptsDrop}"
                            Command="{Binding PrepareAddCommand}"
                            ToolTip.Tip="Route a source here">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="{StaticResource StrokePlus}" VerticalAlignment="Center" />
                            <TextBlock Text="Add" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Width="260" Spacing="2" Margin="2">
                                    <TextBlock Classes="groupHeader" Text="Nothing else to add" Margin="8,6"
                                               IsVisible="{Binding !HasAddOptions}" />
                                    <ItemsControl ItemsSource="{Binding AddOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:AddOption">
                                                <Button Classes="pickRow" Command="{Binding ConnectCommand}"
                                                        Click="OnPickClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <Border Classes="tile chip" Background="{Binding TileBrush}">
                                                            <Panel>
                                                                <TextBlock Classes="tileLetter" Text="{Binding Initials}" IsVisible="{Binding IsLetterTile}" />
                                                                <Path Classes="glyph" IsVisible="{Binding !IsLetterTile}"
                                                                      Data="{Binding Glyph, Converter={x:Static views:GlyphConverter.Instance}}" />
                                                            </Panel>
                                                        </Border>
                                                        <TextBlock Classes="nm" Text="{Binding Title}" FontSize="13"
                                                                   VerticalAlignment="Center" MaxWidth="150" />
                                                        <TextBlock Classes="typeLine" Text="{Binding TypeLine}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </WrapPanel>

                <!-- Row menu: details, hands off, delete (virtual sinks we own) -->
                <Button Grid.Column="5" Classes="icon" Name="RowMenuButton" VerticalAlignment="Center"
                        Margin="8,0,0,0" ToolTip.Tip="More"
                        Command="{Binding PrepareDeleteSinkCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource MutedBrush}" />
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource MutedBrush}" />
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource MutedBrush}" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="300" Spacing="10" Margin="6">
                                <TextBlock Classes="nm" Text="{Binding Title}" />
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                    <TextBlock Classes="typeLine" Text="Node" Margin="0,0,12,4" />
                                    <SelectableTextBlock Grid.Column="1" Classes="typeLine" Text="{Binding SinkName}"
                                                         TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Classes="typeLine" Text="Format" Margin="0,0,12,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="typeLine" Text="{Binding Format}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="body" Text="Hands off" VerticalAlignment="Center"
                                               ToolTip.Tip="AutoRoute never creates or removes links on this output" />
                                    <ToggleSwitch Grid.Column="1" Classes="compact"
                                                  IsChecked="{Binding IsProtected, Mode=OneWay}"
                                                  Command="{Binding ToggleProtectCommand}" />
                                </Grid>
                                <StackPanel Spacing="8" IsVisible="{Binding IsManagedSink}">
                                    <Border Height="1" Background="{DynamicResource CardBorderBrush}" />
                                    <TextBlock Classes="legendText" TextWrapping="Wrap"
                                               Text="{Binding DeleteImpactText}" />
                                    <CheckBox IsChecked="{Binding DeleteAffectedPolicy}"
                                              IsVisible="{Binding HasDeleteImpact}"
                                              Content="Also delete these rules" />
                                    <Button Classes="chipAction" HorizontalAlignment="Right"
                                            Content="Delete virtual sink"
                                            Command="{Binding ConfirmDeleteSinkCommand}"
                                            Click="OnConfirmDeleteSinkClick" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
