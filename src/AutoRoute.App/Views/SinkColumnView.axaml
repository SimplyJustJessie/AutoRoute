<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AutoRoute.App.ViewModels"
             xmlns:views="using:AutoRoute.App.Views"
             xmlns:behaviors="using:AutoRoute.App.Behaviors"
             xmlns:design="using:AutoRoute.App.Design"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="520"
             x:Class="AutoRoute.App.Views.SinkColumnView"
             x:DataType="vm:SinkColumnViewModel"
             d:DataContext="{x:Static design:DesignData.Column}">

    <Border Classes="column"
            Classes.protected="{Binding IsProtected}"
            behaviors:DropTargetBehavior.DropCommand="{Binding ConnectCommand}"
            behaviors:DropTargetBehavior.AcceptsDrop="{Binding AcceptsDrop}">
        <Panel>
            <Grid RowDefinitions="Auto,*">

                <!-- Header = the Target Sink -->
                <Border Grid.Row="0" Classes="columnHeader">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                        <Path Grid.Column="0" Data="{StaticResource IconSpeaker}"
                              Fill="{DynamicResource MutedBrush}"
                              Width="13" Height="13" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,8,0" />

                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="columnTitle body" Text="{Binding Title}" />
                                <Border Classes="chip managed" VerticalAlignment="Center"
                                        IsVisible="{Binding IsManagedSink}"
                                        ToolTip.Tip="A virtual sink AutoRoute owns — created at boot by the generated config and kept alive by the watcher">
                                    <TextBlock Text="VIRTUAL" />
                                </Border>
                            </StackPanel>
                            <TextBlock Classes="subtitle" Text="{Binding Subtitle}"
                                       IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <Border Grid.Column="2" Classes="countChip" Margin="8,0,4,0"
                                ToolTip.Tip="Sources currently routed into this Target Sink">
                            <TextBlock Text="{Binding Cards.Count}" />
                        </Border>

                        <Button Grid.Column="3" Classes="icon"
                                Classes.locked="{Binding IsProtected}"
                                Command="{Binding ToggleProtectCommand}"
                                ToolTip.Tip="Protect / unprotect this Target Sink (do not touch)">
                            <Panel>
                                <Path Data="{StaticResource IconUnlock}" IsVisible="{Binding !IsProtected}" />
                                <Path Data="{StaticResource IconLock}" IsVisible="{Binding IsProtected}" />
                            </Panel>
                        </Button>

                        <!-- Delete (managed virtual sinks only): confirm flyout with the deletion impact -->
                        <Button Grid.Column="4" Classes="icon" Name="DeleteSinkButton"
                                IsVisible="{Binding IsManagedSink}"
                                Command="{Binding PrepareDeleteSinkCommand}"
                                ToolTip.Tip="Delete this virtual sink">
                            <Path Data="{StaticResource IconClose}" />
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Width="300" Spacing="10" Margin="6">
                                        <TextBlock Classes="sectionLabel" Text="DELETE VIRTUAL SINK" />
                                        <TextBlock Classes="legendText" TextWrapping="Wrap">
                                            <Run Text="Removes " /><Run Text="{Binding Title}" FontWeight="Bold" /><Run Text=" from the graph, the generated config, and rules.json. Links into it disappear with it." />
                                        </TextBlock>
                                        <TextBlock Classes="legendText" TextWrapping="Wrap"
                                                   Text="{Binding DeleteImpactText}" />
                                        <CheckBox IsChecked="{Binding DeleteAffectedPolicy}"
                                                  IsVisible="{Binding HasDeleteImpact}"
                                                  Content="Also delete these rules/suppressions" />
                                        <Button Classes="chipAction" HorizontalAlignment="Right"
                                                Content="Delete sink"
                                                Command="{Binding ConfirmDeleteSinkCommand}"
                                                Click="OnConfirmDeleteSinkClick" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </Border>

                <!-- Body = Source cards feeding this Target Sink -->
                <ScrollViewer Grid.Row="1" Padding="10,10,10,4"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Panel>
                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:SourceCardViewModel">
                                    <views:SourceCardView IsVisible="{Binding IsVisible}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state: dashed drop zone -->
                        <Panel IsVisible="{Binding IsEmpty}" Margin="2,2,2,8" Height="112"
                               VerticalAlignment="Top">
                            <Rectangle Classes="dropZone" />
                            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconDrop}" Stroke="{DynamicResource FaintBrush}"
                                      StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                      Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" />
                                <TextBlock Classes="hint" Text="Drop a Source here" />
                            </StackPanel>
                        </Panel>
                    </Panel>
                </ScrollViewer>
            </Grid>

            <!-- Drag-over glow (pulses via CardStyles while a drag hovers) -->
            <Border Classes="dropOverlay" />
        </Panel>
    </Border>
</UserControl>
